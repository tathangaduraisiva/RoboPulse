# RoboPulse Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=robopulse
DB_USER=robopulse_user
DB_PASSWORD=robopulse_password

# Database Connection Pool Settings
DB_MAX_CONNECTIONS=20
