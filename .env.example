# RoboPulse Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=robopulse
DB_USER=robopulse_user
DB_PASSWORD=robopulse_password

# Database Connection Pool Settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Redis Configuration (For future telemetry cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Google OAuth 2.0 ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Under "Authorised redirect URIs" add:
#   http://localhost:5000/api/auth/google/callback   (local dev)
#   https://<your-domain>/api/auth/google/callback  (production)
#
# Leave all three blank (or omit them) to disable Google login;
# the existing username / password login continues to work normally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Frontend URL (used by the backend OAuth callback redirect) ──────
# Defaults to http://localhost:5173 when not set.
# Set this to your production frontend URL when deploying.
FRONTEND_URL=http://localhost:5173

# ── JWT Secret ──────────────────────────────────────────────────────
# Used to sign authentication tokens.  Change this to a long random
# string in any non-development environment.
JWT_SECRET=robopulse-dev-secret
